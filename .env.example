# Terrarium API — copy to .env for local dev (never commit .env)
TERRARIUM_ENV=local
TERRARIUM_LISTEN=127.0.0.1:3000
TERRARIUM_DB=./terrarium.db
TERRARIUM_DASHBOARD_DIR=apps/dashboard
TERRARIUM_FAUCET_AMOUNT=10000
TERRARIUM_DEV_AUTH=1

# Firebase (staging/prod — public web config, not secrets)
# FIREBASE_PROJECT_ID=terrarium-506917
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=terrarium-506917.firebaseapp.com

# When set, spawn and snapshot delegate to the always-on host (production/staging).
# TERRARIUM_HOST_URL=https://terrarium-host-staging-….run.app
# TERRARIUM_HOST_TOKEN=…

# When FIREBASE_PROJECT_ID is set: dashboard requires Firebase ID tokens.
# When unset: TERRARIUM_DEV_AUTH=1 enables dev session tokens for local/CI.
