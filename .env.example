# Terrarium API — copy to .env for local dev (never commit .env)
TERRARIUM_ENV=local
TERRARIUM_LISTEN=127.0.0.1:3000
TERRARIUM_DB=./terrarium.db
TERRARIUM_DASHBOARD_DIR=apps/dashboard
TERRARIUM_FAUCET_AMOUNT=10000

# Staging: TERRARIUM_ENV=staging (free mint ON)
# Production: TERRARIUM_ENV=production (free mint OFF)
