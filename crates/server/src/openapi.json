{
  "openapi": "3.1.0",
  "info": {
    "title": "Terrarium API",
    "version": "1.0.0",
    "description": "Deploy programmable creatures into a persistent real-time simulation.\n\nAuthenticate with a Firebase ID token or an API key (`tr_…`) in the `Authorization: Bearer` header.\n\nMint API keys via `POST /v1/api-keys` while signed in."
  },
  "servers": [
    {
      "url": "https://terrarium-506917.web.app/api",
      "description": "Production (Firebase Hosting proxy)"
    },
    { "url": "http://localhost:8080", "description": "Local dev (direct to :8080)" }
  ],
  "tags": [
    { "name": "public", "description": "No authentication required" },
    { "name": "account", "description": "Account and API keys" },
    { "name": "world", "description": "Simulation state" },
    { "name": "control", "description": "External creature control (API key only)" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Firebase ID token or Terrarium API key (`tr_…`)"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } },
        "required": ["error"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "tick_hz": { "type": "integer", "example": 10 }
        }
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "uid": { "type": "string" },
          "credits": { "type": "integer", "format": "int64" },
          "account_creature_id": {
            "type": "string",
            "description": "Stable u64 creature id for this account (same namespace as deployed creatures)"
          }
        },
        "required": ["uid", "credits", "account_creature_id"]
      },
      "Creature": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "energy": { "type": "integer", "format": "int64" },
          "health": { "type": "integer" },
          "max_health": { "type": "integer" },
          "owner_uid": { "type": "string" },
          "facing": { "type": "integer" }
        }
      },
      "Tile": {
        "type": "object",
        "properties": {
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "kind": { "type": "integer", "description": "1=solid, 3=corpse, 4=food" },
          "energy": { "type": "integer", "format": "int64" },
          "death_reason": { "type": "string" }
        }
      },
      "WorldResponse": {
        "type": "object",
        "properties": {
          "deploy_cost": { "type": "integer", "format": "int64" },
          "corpse_energy": { "type": "integer", "format": "int64" },
          "creatures": { "type": "array", "items": { "$ref": "#/components/schemas/Creature" } },
          "tiles": { "type": "array", "items": { "$ref": "#/components/schemas/Tile" } }
        }
      },
      "DeployRequest": {
        "type": "object",
        "required": ["x", "y", "code", "energy"],
        "properties": {
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "code": { "type": "string", "description": "WAT source or label when using wasm_b64" },
          "energy": { "type": "integer", "format": "int64", "description": "Extra glims beyond corpse floor; credits charged = corpse_energy + energy (1:1 import)" },
          "wasm_b64": { "type": "string", "description": "Precompiled WASM (base64, max 64 KB)" }
        }
      },
      "DeployResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "energy": { "type": "integer", "format": "int64" },
          "credits": { "type": "integer", "format": "int64" }
        }
      },
      "MintApiKeyRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "ci-deploy" }
        }
      },
      "ApiKey": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "prefix": { "type": "string", "description": "First chars of the key for identification" },
          "created_at": { "type": "string" },
          "last_used_at": { "type": "string" }
        }
      },
      "MintApiKeyResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiKey" },
          {
            "type": "object",
            "properties": {
              "secret": {
                "type": "string",
                "description": "Full API key — returned once at creation"
              }
            },
            "required": ["secret"]
          }
        ]
      },
      "ApiKeyList": {
        "type": "object",
        "properties": {
          "keys": { "type": "array", "items": { "$ref": "#/components/schemas/ApiKey" } }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["public"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Server is up",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/world": {
      "get": {
        "tags": ["world", "public"],
        "summary": "World state",
        "description": "Current creatures, tiles, and deploy costs (REST). Live updates use WebSocket deltas.",
        "responses": {
          "200": {
            "description": "World snapshot",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorldResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/world/ws": {
      "get": {
        "tags": ["world", "public"],
        "summary": "World WebSocket",
        "description": "Real-time deltas. Upgrade to WebSocket; messages are JSON deltas (`full: true` on connect/resync).",
        "x-hidden": true,
        "responses": {
          "101": { "description": "Switching Protocols" }
        }
      }
    },
    "/v1/control/ws": {
      "get": {
        "tags": ["control"],
        "summary": "Creature control WebSocket",
        "description": "Attach external logic to a creature you own. **API key only** (`tr_…`); Firebase session tokens are rejected. Query: `creature_id` (u64). Messages: `signal`, `broadcast`, `recv` with 64-byte envelope JSON.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "creature_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "description": "u64 creature id (decimal string)" }
          }
        ],
        "responses": {
          "101": { "description": "Switching Protocols" },
          "401": { "description": "Unauthorized or wrong auth type" },
          "403": { "description": "Creature not owned by this account" },
          "404": { "description": "Creature not found" }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": ["account"],
        "summary": "Current account",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Account credits",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MeResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/api-keys": {
      "get": {
        "tags": ["account"],
        "summary": "List API keys",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "API key list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiKeyList" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "tags": ["account"],
        "summary": "Mint API key",
        "description": "Creates a new key. The full `secret` is returned once — store it safely.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MintApiKeyRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Key minted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MintApiKeyResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/api-keys/{id}": {
      "delete": {
        "tags": ["account"],
        "summary": "Revoke API key",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Revoked" },
          "404": { "description": "Not found" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/deploy": {
      "post": {
        "tags": ["world"],
        "summary": "Deploy creature",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeployRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Creature deployed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeployResponse" }
              }
            }
          },
          "402": { "description": "Insufficient credits" },
          "409": { "description": "Cell occupied" },
          "400": {
            "description": "Invalid deploy request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  }
}
