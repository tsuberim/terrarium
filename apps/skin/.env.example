# Copy to .env.local — or run ../../scripts/setup-dev.sh to generate automatically.
# Leave VITE_API_BASE and VITE_WS_BASE empty so Vite proxies /api → localhost:8080.
VITE_API_BASE=
VITE_WS_BASE=
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id
